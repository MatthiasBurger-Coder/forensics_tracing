<!DOCTYPE aspectj PUBLIC "-//AspectJ//DTD//EN" "aspectj.dtd">
<aspectj>
    <weaver options="-XnoInline">
        <!-- Weave nur deinen Code -->
        <include within="de.burger.forensics..*"/>
        <!-- Logging-/Infra-Paket NICHT weaven, um Reentrancy/Noise zu vermeiden -->
        <exclude within="de.burger.forensics.infrastructure.logging..*"/>
    </weaver>
    <aspects>
        <aspect name="de.burger.forensics.infrastructure.logging.MethodLoggingAspect"/>
    </aspects>
</aspectj>
